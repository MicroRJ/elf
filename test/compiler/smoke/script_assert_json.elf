data := json {
	"name": "elf",
	"count": 3,
	"ok": true,
	"nope": false,
	"none": null,
	"items": [1, 2, {"nested": "yes"}],
	"escaped": "a\nb",
	"unicode": "\u263A"
}

test_assert(data.name == "elf")
test_assert(data.count == 3)
test_assert(data.ok == 1)
test_assert(data.nope == 0)
test_assert(data.none == nil)
test_assert(elf.type_of(data.items) == "array")

test_assert(data.items[0] == 1)
test_assert(data.items[1] == 2)
test_assert(data.items[2].nested == "yes")

test_assert(data.escaped == "a\nb")
test_assert(data.unicode == "\u263A")

parsed := elf.json.parse("{\"name\":\"elf\",\"items\":[1,2,null]}")
test_assert(parsed.name == "elf")
test_assert(elf.type_of(parsed.items) == "array")
test_assert(parsed.items[0] == 1)
test_assert(parsed.items[2] == nil)

round_trip := elf.json.parse(elf.json.stringify(parsed))
test_assert(round_trip.name == "elf")
test_assert(round_trip.items[0] == 1)
test_assert(round_trip.items[2] == nil)
test_assert(elf.json.stringify(elf.json.parse("[]")) == "[]")
test_assert(elf.json.stringify(elf.json.parse("{}")) == "{}")
test_assert(elf.json.stringify(json []) == "[]")
test_assert(elf.json.stringify(json {}) == "{}")
test_assert(elf.json.stringify(nil) == "null")

invalid := elf.json.parse("{")
test_assert(elf.is_error(invalid))
test_assert(invalid.line == 1)

cyclic := {}
cyclic.self = cyclic
test_assert(elf.is_error(elf.json.stringify(cyclic)))
cyclic_array := [nil]
cyclic_array[0] = cyclic_array
test_assert(elf.is_error(elf.json.stringify(cyclic_array)))
test_assert(elf.is_error(elf.json.stringify(fun() {})))

lines := elf.json.load_jsonl("test/compiler/smoke/core_lib_data.jsonl")
test_assert(elf.type_of(lines) == "array")
test_assert(lines:length() == 3)
test_assert(lines[0].name == "first")
test_assert(lines[0].value == 1)
test_assert(lines[1][0] == 2)
test_assert(lines[1][1] == 3)
test_assert(lines[2] == nil)

ret 321
