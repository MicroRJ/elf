elf.assert(1)
elf.assert(1, "numeric assertions remain supported")

test_assert(elf.type_of(nil) == "nil")
test_assert(elf.type_of(7) == "integer")
test_assert(elf.type_of(7.5) == "number")
test_assert(1e3 == 1000)
test_assert(1.5e2 == 150)
test_assert(.5e+1 == 5)
test_assert(1e-2 > 0 && 1e-2 < 1)
test_assert(elf.type_of("elf") == "string")
test_assert(elf.type_of({}) == "table")

error_details := {
	kind = "filesystem",
	code = 2,
}
failure := elf.error("file not found", error_details)
test_assert(elf.type_of(failure) == "error")
test_assert(elf.is_error(failure))
test_assert(elf.is_error(error_details) == 0)
test_assert(failure.message == "file not found")
test_assert(failure.kind == "filesystem")
test_assert(failure.code == 2)
test_assert(failure.missing == nil)
test_assert(elf.to_string(failure) == "file not found")
test_assert(elf.is_readonly(failure))
error_details.kind = "changed"
test_assert(failure.kind == "filesystem")
return_error := fun() ret failure
test_assert(return_error() == failure)
error_holder := [failure]
test_assert(error_holder[0].message == "file not found")

test_assert(elf.is_string("elf"))
test_assert(elf.is_string(7) == 0)
test_assert(elf.is_numeric(7))
test_assert(elf.is_numeric(7.5))
test_assert(elf.is_numeric("7") == 0)
test_assert(elf.type_of(elf.to_number(7)) == "number")
test_assert(elf.to_integer(7.75) == 7)

test_assert(elf.to_string(nil) == "nil")
test_assert(elf.to_string(42) == "42")
test_assert(elf.to_string(1.5) == "1.500000")
test_assert(elf.to_string("elf") == "elf")
number := 12.345
test_assert(number:fmt(".00") == "12")
test_assert(number:fmt(".02") == "12.35")
test_assert(1.5:fmt(".02") == "1.50")
test_assert((-0.0):fmt(".02") == "-0.00")
test_assert(elf.is_error(number:fmt("2")))
test_assert(elf.is_error(number:fmt(".100")))
string_table := { answer = 42 }
test_assert(elf.to_string(string_table) == "{answer = 42}")
test_assert(elf.to_string(string_table) == "" + string_table)

child := {}
root := { child = child }
root.self = root
test_assert(elf.freeze(root) == root)
test_assert(elf.is_readonly(root))
test_assert(elf.is_readonly(child))

probe := fun(a, ...) {
	test_assert(elf.nargs() == 4)
	test_assert(elf.nvargs() == 2)
	test_assert(elf.nrets() == 0)
	test_assert(elf.arg(-1) == nil)
	test_assert(elf.arg(4) == nil)
	test_assert(elf.varg(-1) == nil)
	test_assert(elf.varg(2) == nil)
	test_assert(elf.arg(1) == 10)
	test_assert(elf.varg(0) == 20)
	test_assert(elf.varg(1) == 30)
}
probe(10, 20, 30)

test_assert(elf.load_file("test/compiler/smoke/core_lib_loaded.elf", 41) == 42)

document := elf.json.load_file("test/compiler/smoke/core_lib_data.json")
test_assert(document.answer == 42)
test_assert(document.items[0] == 3)
test_assert(document.items[2] == 8)
test_assert(elf.json.load_file("test/compiler/smoke/does_not_exist.json") == nil)

gc_counters := elf.gc.counters()
test_assert(elf.type_of(gc_counters.allocated_objects) == "integer")
test_assert(elf.type_of(gc_counters.allocated_bytes) == "integer")
test_assert(elf.type_of(gc_counters.allocated_closures) == "integer")
test_assert(elf.type_of(gc_counters.allocated_tables) == "integer")
test_assert(elf.type_of(gc_counters.allocated_strings) == "integer")
test_assert(elf.type_of(gc_counters.allocated_buffers) == "integer")
test_assert(elf.type_of(gc_counters.freed_objects) == "integer")
test_assert(elf.type_of(gc_counters.freed_bytes) == "integer")
test_assert(elf.type_of(gc_counters.collections) == "integer")
test_assert(elf.type_of(gc_counters.live_objects) == "integer")
test_assert(elf.type_of(gc_counters.live_bytes) == "integer")
test_assert(elf.type_of(gc_counters.peak_live_bytes) == "integer")
test_assert(elf.type_of(gc_counters.collection_time_ns) == "integer")
test_assert(elf.type_of(gc_counters.last_collection_time_ns) == "integer")
test_assert(elf.type_of(gc_counters.max_collection_time_ns) == "integer")
test_assert(gc_counters.peak_live_bytes >= gc_counters.live_bytes)
test_assert(gc_counters.allocated_bytes - gc_counters.freed_bytes == gc_counters.live_bytes)
allocated_objects := gc_counters.allocated_objects
allocated_tables := gc_counters.allocated_tables
allocated_bytes := gc_counters.allocated_bytes
allocation_probe := {}
gc_counters = elf.gc.counters(gc_counters)
test_assert(gc_counters.allocated_objects > allocated_objects)
test_assert(gc_counters.allocated_tables == allocated_tables + 2)
test_assert(gc_counters.allocated_bytes > allocated_bytes)
reused_objects := gc_counters.allocated_objects
reused_tables := gc_counters.allocated_tables
test_assert(elf.gc.counters(gc_counters) == gc_counters)
test_assert(gc_counters.allocated_objects == reused_objects)
test_assert(gc_counters.allocated_tables == reused_tables)
test_assert(allocation_probe:length() == 0)

vm_counters := elf.vm.counters()
test_assert(elf.type_of(vm_counters.calls) == "integer")
test_assert(elf.type_of(vm_counters.closure_calls) == "integer")
test_assert(elf.type_of(vm_counters.native_calls) == "integer")
test_assert(elf.type_of(vm_counters.instructions) == "integer")
test_assert(elf.type_of(vm_counters.max_stack_slots) == "integer")
test_assert(elf.type_of(vm_counters.max_call_depth) == "integer")
test_assert(vm_counters.instructions > 0)
test_assert(vm_counters.max_stack_slots > 0)
test_assert(vm_counters.max_call_depth > 0)
vm_counters = elf.vm.counters(vm_counters)
vm_calls := vm_counters.calls
vm_closure_calls := vm_counters.closure_calls
vm_native_calls := vm_counters.native_calls
vm_counters = elf.vm.counters(vm_counters)
test_assert(vm_counters.calls == vm_calls + 1)
test_assert(vm_counters.closure_calls == vm_closure_calls)
test_assert(vm_counters.native_calls == vm_native_calls + 1)

vm_counters = elf.vm.counters(vm_counters)
vm_calls = vm_counters.calls
vm_closure_calls = vm_counters.closure_calls
vm_native_calls = vm_counters.native_calls
vm_call_probe := fun() {}
vm_call_probe()
vm_counters = elf.vm.counters(vm_counters)
test_assert(vm_counters.calls == vm_calls + 2)
test_assert(vm_counters.closure_calls == vm_closure_calls + 1)
test_assert(vm_counters.native_calls == vm_native_calls + 1)

test_assert(elf.fs.get_paths() != nil)
paths := elf.fs.get_paths("test/compiler/smoke")
test_assert(paths != nil)
test_assert(elf.type_of(paths) == "array")
found_basic := 0
for path := paths[...] ? {
	if elf.path.filename(path) == "basic.elf" ? { found_basic = 1 }
}
test_assert(found_basic)
test_assert(elf.fs.get_paths("test/compiler/smoke/does-not-exist") == nil)

flat_paths := elf.fs.get_paths("src", 0)
recursive_paths := elf.fs.get_paths("src", 2)
found_flat_l_string := 0
found_recursive_l_string := 0
for path := flat_paths[...] ? {
	if elf.path.filename(path) == "l_string.c" ? { found_flat_l_string = 1 }
}
for path := recursive_paths[...] ? {
	if elf.path.filename(path) == "l_string.c" ? { found_recursive_l_string = 1 }
}
test_assert(found_flat_l_string == 0)
test_assert(found_recursive_l_string)
test_assert(elf.fs.get_paths("test/compiler/smoke", -1) == nil)
test_assert(elf.fs.get_paths("test/compiler/smoke", 33) == nil)

iteration := { count = 0, found_l_string = 0 }
iteration_count := elf.fs.for_each_path("src", 2, fun(path) {
	iteration.count += 1
	if elf.path.filename(path) == "l_string.c" ? { iteration.found_l_string = 1 }
})
test_assert(iteration_count == iteration.count)
test_assert(iteration_count == recursive_paths:length())
test_assert(iteration.found_l_string)
test_assert(elf.fs.for_each_path("test/compiler/smoke/does-not-exist", fun(path) {}) == nil)

test_assert(elf.print("") == 0)
test_assert(elf.println("") == 1)
test_assert(elf.printl("") == 1)

ret 4242
