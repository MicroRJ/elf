sum := 0
count := 0

for i := 0; i < 10; i += 1 ? {
	sum += i
	count += 1
}

test_assert(sum == 45)
test_assert(count == 10)

odd_sum := 0
for i := 0; i < 10; i += 1 ? {
	if i % 2 == 0 ? {
		continue
	}
	odd_sum += i
}

test_assert(odd_sum == 25)

pair_sum := 0
for i, j := 0, 10; i < 3; i += 1 ? {
	pair_sum += i + j
}

test_assert(pair_sum == 33)

ret sum + odd_sum + pair_sum
