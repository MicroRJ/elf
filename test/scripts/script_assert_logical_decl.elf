new_x := 10
new_y := 20
apple_x := 10
apple_y := 20

eating := new_x == apple_x && new_y == apple_y
test_assert(eating == 1)

apple_y = 21
eating = new_x == apple_x && new_y == apple_y
test_assert(eating == 0)

test_assert(nil != 0, "nil is not equal to zero")

nil_branch := 0
if nil ? {
	nil_branch = 1
}
test_assert(nil_branch == 0, "nil does not enter a true branch")

ret 42
