test_assert("abcdef":slice(1, 4) == "bcd")
test_assert("abcdef":slice(3) == "def")
test_assert("abcdef":slice(-3) == "def")
test_assert("abcdef":slice(1, -1) == "bcde")
test_assert("abcdef":slice(-6, 6) == "abcdef")
test_assert("abcdef":slice(2, 2) == "")
test_assert("abcdef":slice(6) == "")
test_assert("":slice(0) == "")
test_assert("":slice(0, 0) == "")
test_assert("A\0BC":slice(1, 3) == "\0B")

test_assert(elf.is_error("abc":slice()))
test_assert(elf.is_error(elf.metatable("").slice(0)))

test_assert(elf.is_error("abc":slice(1.0)))
test_assert(elf.is_error("abc":slice(1.5)))
test_assert(elf.is_error("abc":slice(0, 2.0)))
test_assert(elf.is_error("abc":slice(0, 2.5)))
test_assert(elf.is_error("abc":slice("1")))
test_assert(elf.is_error("abc":slice(0, "2")))
test_assert(elf.is_error("abc":slice(nil)))
test_assert(elf.is_error("abc":slice(0, nil)))
test_assert(elf.is_error("abc":slice([])))

test_assert(elf.is_error("abc":slice(-4)))
test_assert(elf.is_error("abc":slice(4)))
test_assert(elf.is_error("abc":slice(0, -4)))
test_assert(elf.is_error("abc":slice(0, 4)))
test_assert(elf.is_error("abc":slice(2, 1)))
test_assert(elf.is_error("abc":slice(-9223372036854775808)))
test_assert(elf.is_error("abc":slice(9223372036854775807)))
test_assert(elf.is_error("abc":slice(0, -9223372036854775808)))
test_assert(elf.is_error("abc":slice(0, 9223372036854775807)))

failure, extra := "abc":slice(0.0)
test_assert(elf.is_error(failure))
test_assert(extra == nil)
test_assert(failure.message == "string.slice index must be an integer")
test_assert("abc":slice(0, 2) == "ab")
