order := 0

{
	defer order = order * 10 + 1
	defer order = order * 10 + 2
}

test_assert(order == 21)

defer_state := {side = 1, nested_trace = 0}
return_before_defer := fun(state) {
	defer state.side = 3
	ret state.side
}

value := return_before_defer(defer_state)
test_assert(value == 1)
test_assert(defer_state.side == 3)

loop_log := 0
i := 0

while i < 10 ? {
	i += 1
	defer loop_log = loop_log * 10 + i

	if i == 2 ? {
		continue
	}

	if i == 4 ? {
		break
	}
}

test_assert(loop_log == 1234)

outer := fun(state) {
	defer state.nested_trace += 100

	inner := fun(inner_state) {
		defer inner_state.nested_trace += 10
		ret 7
	}

	result := inner(state)
	test_assert(result == 7)
	test_assert(state.nested_trace == 10)
	ret result
}

outer_result := outer(defer_state)
test_assert(outer_result == 7)
test_assert(defer_state.nested_trace == 110)

ret order * 100000 + value * 10000 + defer_state.side * 1000 + loop_log + defer_state.nested_trace
