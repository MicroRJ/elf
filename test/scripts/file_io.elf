path := "build/file_io_test.tmp"
elf.fs.remove_file(path)

missing := elf.fs.open(path, "r")
test_assert(elf.is_error(missing))
test_assert(elf.is_error(elf.fs.open(path, "rb")))
test_assert(elf.is_error(elf.fs.open(path)))
test_assert(elf.is_error(elf.fs.open(42, "r")))
test_assert(elf.is_error(elf.fs.open(path, 42)))

file := elf.fs.open(path, "w+")
test_assert(elf.is_error(file) == 0)

source := elf.buffer():append("abcdef")
test_assert(elf.is_error(file:read("not a buffer", 1)))
test_assert(elf.is_error(file:read(elf.buffer(), -1)))
test_assert(elf.is_error(file:write("not a buffer")))
test_assert(elf.is_error(file:write(source, 7)))
test_assert(elf.is_error(file:seek("zero", "begin")))
test_assert(elf.is_error(file:seek(0, "middle")))
test_assert(elf.is_error(file:tell(1)))
test_assert(elf.is_error(file:flush(1)))
test_assert(file:write(source, 1, 4) == 4)
test_assert(file:flush())
test_assert(file:tell() == 4)
test_assert(file:size() == 4)
test_assert(file:seek(0, "begin") == 0)

contents := elf.buffer():append("prefix:")
test_assert(file:read(contents, 16) == 4)
test_assert(contents:to_string() == "prefix:bcde")
test_assert(file:read(contents, 16) == 0)
test_assert(file:close())
test_assert(file:close())
test_assert(elf.is_error(file:read(contents, 1)))
test_assert(elf.is_error(file:flush()))

append := elf.fs.open(path, "a")
test_assert(elf.is_error(append) == 0)
test_assert(append:write(elf.buffer():append("!")) == 1)
test_assert(elf.is_error(append:read(elf.buffer(), 1)))
test_assert(append:close())

reader := elf.fs.open(path, "r")
test_assert(elf.is_error(reader) == 0)
result := elf.buffer()
test_assert(reader:read(result, 16) == 5)
test_assert(result:to_string() == "bcde!")
test_assert(elf.is_error(reader:write(result)))
test_assert(elf.is_error(reader:flush()))
test_assert(reader:close())

test_assert(elf.fs.remove_file(path))
