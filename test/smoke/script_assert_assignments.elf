x := 1
test_assert(x == 1)

x = 2
test_assert(x == 2)

a, b, c := 1, 2, 3
test_assert(a == 1)
test_assert(b == 2)
test_assert(c == 3)

a, b, c = 4, 5, 6
test_assert(a == 4)
test_assert(b == 5)
test_assert(c == 6)

a, b = b, a
test_assert(a == 5)
test_assert(b == 4)

a, b = 7
test_assert(a == 7)
test_assert(b == nil)

t := {x = 3}
test_assert(t.x == 3)

t.x = 4
test_assert(t.x == 4)

t.y ?= 5
test_assert(t.y == 5)

t.y ?= 6
test_assert(t.y == 5)

from_nil := nil ?? 7
test_assert(from_nil == 7)

from_value := 8 ?? 9
test_assert(from_value == 8)

short_circuit := 10 ?? test_assert(0)
test_assert(short_circuit == 10)

ret 99
