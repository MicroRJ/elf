table := { first = 10, second = 20 }
test_assert(table:length() == 2)
test_assert(table:size() == 2)
test_assert(table:has("first"))
test_assert(table:delete("first") == 10)
test_assert(table:has("first") == 0)
test_assert(table.second == 20)

table.third = 30
keys := table:keys()
test_assert(elf.type_of(keys) == "array")
test_assert(keys:length() == 2)

table.nil_value = nil
test_assert(table:has("nil_value"))
test_assert(table:delete("nil_value") == nil)
test_assert(table:has("nil_value") == 0)

table_meta := elf.metatable(table)
test_assert(table_meta.map_equal == nil)
test_assert(table_meta.haskey == nil)
test_assert(table_meta.values == nil)
test_assert(table_meta.pairs == nil)
test_assert(table_meta.clone == nil)
test_assert(table_meta.merge == nil)

test_assert(table:clear() == table)
test_assert(table:length() == 0)
test_assert(table:has("second") == 0)

ret 144
