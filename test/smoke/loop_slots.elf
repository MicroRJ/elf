outer_sum := 0
outer_iters := 0
nested_sum := 0
multi_sum := 0
pair_sum := 0
triple_array_sum := 0

{
	for i := 0 ... 4 ? {
		test_assert(#get_mem(i) == 9)

		outer_iters += 1

		if i == 1 ? {
			continue_slot := i
			test_assert(#get_mem(continue_slot) == 10)
			continue
		}

		if i == 3 ? {
			break_slot := i
			test_assert(#get_mem(break_slot) == 10)
			break
		}

		body_slot := i
		test_assert(#get_mem(body_slot) == 10)
		outer_sum += body_slot
	}

	test_assert(outer_sum == 2)
	test_assert(outer_iters == 4)

	after_loop := 123
	test_assert(#get_mem(after_loop) == 7)
}

{
	for x := 0 ... 3 ? {
		test_assert(#get_mem(x) == 9)

		before_inner := x
		test_assert(#get_mem(before_inner) == 10)

		for y := 0 ... 4 ? {
			test_assert(#get_mem(y) == 13)

			if y == 1 ? {
				continue
			}

			if y == 3 ? {
				break
			}

			nested_sum += x * 10 + y
		}

		after_inner := x
		test_assert(#get_mem(after_inner) == 11)
	}

	test_assert(nested_sum == 66)

	after_nested_loop := 456
	test_assert(#get_mem(after_nested_loop) == 7)
}

{
	multi_iters := 0

	for a, b, c := 0 ... 9 ? {
		test_assert(#get_mem(a) == 10)
		test_assert(#get_mem(b) == 11)
		test_assert(#get_mem(c) == 12)

		multi_body := a + b + c
		test_assert(#get_mem(multi_body) == 13)

		multi_sum += multi_body
		multi_iters += 1
	}

	test_assert(multi_sum == 36)
	test_assert(multi_iters == 3)

	after_multi := 789
	test_assert(#get_mem(after_multi) == 8)
}

{
	values := {10, 20, 30, 40}

	for left, right := values[0 ... 4] ? {
		test_assert(#get_mem(left) == 11)
		test_assert(#get_mem(right) == 12)

		pair_body := left + right
		test_assert(#get_mem(pair_body) == 13)

		pair_sum += pair_body
	}

	test_assert(pair_sum == 100)

	after_pair := 999
	test_assert(#get_mem(after_pair) == 8)
}

{
	more_values := {1, 2, 3, 4, 5, 6}

	for x0, x1, x2 := more_values[0 ... 6] ? {
		test_assert(#get_mem(x0) == 11)
		test_assert(#get_mem(x1) == 12)
		test_assert(#get_mem(x2) == 13)

		triple_array_body := x0 * 100 + x1 * 10 + x2
		test_assert(#get_mem(triple_array_body) == 14)

		triple_array_sum += triple_array_body
	}

	test_assert(triple_array_sum == 579)

	after_triple_array := 111
	test_assert(#get_mem(after_triple_array) == 8)
}

ret outer_sum * 10000 + outer_iters * 1000 + nested_sum + multi_sum + pair_sum + triple_array_sum
