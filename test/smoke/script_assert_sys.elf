path := "build/sys_smoke_test.txt"
missing := "build/sys_smoke_missing.txt"
fs := elf.fs
path_lib := elf.path
env := elf.env

env_name := "ELF_SMOKE_ENV_7F31"
env.unset(env_name)
test_assert(env.has(env_name) == 0)
test_assert(env.get(env_name) == nil)
test_assert(env.set(env_name, "hello env") == 1)
test_assert(env.has(env_name) == 1)
test_assert(env.get(env_name) == "hello env")
test_assert(env.set(env_name, "") == 1)
test_assert(env.get(env_name) == "")
test_assert(env.unset(env_name) == 1)
test_assert(env.get(env_name) == nil)

fs.remove_file(path)
fs.remove_file(missing)

test_assert(fs.read_text_file(missing) == nil)
test_assert(fs.file_exists(missing) == 0)
test_assert(fs.file_exists("build") == 0)
test_assert(fs.exists(missing) == 0)
test_assert(fs.is_file(missing) == 0)
test_assert(fs.is_directory(missing) == 0)
test_assert(fs.exists("build") == 1)
test_assert(fs.is_file("build") == 0)
test_assert(fs.is_directory("build") == 1)

test_assert(fs.write_text_file(path, "hello fs") == 1)
test_assert(fs.read_text_file(path) == "hello fs")
test_assert(fs.file_exists(path) == 1)
test_assert(fs.exists(path) == 1)
test_assert(fs.is_file(path) == 1)
test_assert(fs.is_directory(path) == 0)

info := fs.get_file_info(path)
test_assert(info != nil)
test_assert(info.size_bytes == 8)
test_assert(info.created_unix_ms > 0)
test_assert(info.accessed_unix_ms > 0)
test_assert(info.modified_unix_ms > 0)

working_directory := fs.get_working_directory()
test_assert(working_directory != nil)
test_assert(fs.set_working_directory(working_directory) == 1)

test_assert(fs.read == nil)
test_assert(fs.write == nil)
test_assert(fs.stat == nil)
test_assert(fs.mkdir == nil)
test_assert(fs.remove == nil)
test_assert(elf.os == nil)

test_assert(path_lib.join("some/path", "name.ext") == "some/path/name.ext")
test_assert(path_lib.filename("some/path/name.ext") == "name.ext")
test_assert(path_lib.stem("some/path/name.ext") == "name")
test_assert(path_lib.extension("some/path/name.ext") == "ext")
test_assert(path_lib.parent("some/path/name.ext") == "some/path")

run := elf.process.run("cmd /d /c echo process-output")
test_assert(run.started == 1)
test_assert(run.success == 1)
test_assert(run.exit_code == 0)
test_assert(run.stdout != "")
test_assert(run.stderr == "")
test_assert(run.error == nil)

error_run := elf.process.run("cmd /d /c echo process-error 1>&2")
test_assert(error_run.started == 1)
test_assert(error_run.stderr != "")

failed_run := elf.process.run("cmd /d /c exit 7")
test_assert(failed_run.started == 1)
test_assert(failed_run.success == 0)
test_assert(failed_run.exit_code == 7)

missing_run := elf.process.run("elf_missing_process_7f31.exe")
test_assert(missing_run.started == 0)
test_assert(missing_run.success == 0)
test_assert(missing_run.error_code != 0)
test_assert(missing_run.error != nil)

test_assert(fs.remove_file(path) == 1)
test_assert(fs.read_text_file(path) == nil)

ret 77
