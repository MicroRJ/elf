elf.println("=== current compiler pipeline demo ===")

fib := fun(n) {
	if n < 2 ? {
		ret n
	}
	ret recurse(n - 1) + recurse(n - 2)
}

gcd := fun(a, b) {
	while b != 0 ? {
		remainder := a % b
		a = b
		b = remainder
	}
	ret a
}

is_prime := fun(value) {
	if value < 2 ? {
		ret 0
	}

	divisor := 2
	while divisor * divisor <= value ? {
		if value % divisor == 0 ? {
			ret 0
		}
		divisor += 1
	}
	ret 1
}

make_offsetter := fun(offset) {
	ret fun(value) {
		ret value + offset
	}
}

add_seven := make_offsetter(7)
numbers := [5, 8, 13, 21, 34, 55]
sum := 0
even_count := 0

for number := numbers[...] ? {
	sum += number
	if number % 2 == 0 ? {
		even_count += 1
	}
}

prime_count := 0
prime_sum := 0
for candidate := 2 ... 30 ? {
	if is_prime(candidate) ? {
		prime_count += 1
		prime_sum += candidate
	}
}

stats := {
	count = numbers:length(),
	sum = sum,
	even_count = even_count,
	prime_count = prime_count,
	prime_sum = prime_sum,
}

stats.average = stats.sum / stats.count
stats.sequence = {
	fib_10 = fib(10),
	offset_35 = add_seven(35),
	gcd_84_30 = gcd(84, 30),
}

countdown := 5
countdown_sum := 0
while countdown > 0 ? {
	countdown_sum += countdown
	countdown -= 1
}

classification := "mixed"
if stats.even_count == stats.count ? {
	classification = "all even"
}
else if stats.even_count == 0 ? {
	classification = "all odd"
}

elf.println(f"numbers: count=${stats.count}, sum=${stats.sum}, average=${stats.average}")
elf.println(f"classification: ${classification}, even=${stats.even_count}")
elf.println(f"primes below 30: count=${stats.prime_count}, sum=${stats.prime_sum}")
elf.println(f"fib(10)=${stats.sequence.fib_10}")
elf.println(f"closure result: 35 + 7 = ${stats.sequence.offset_35}")
elf.println(f"gcd(84, 30)=${stats.sequence.gcd_84_30}")
elf.println(f"countdown sum=${countdown_sum}")

ret stats
