/*
** See Copyright Notice In elf.h
** token.elf
** Metaprogram to generate elf-tkn.h
*/

pf = elf.pf
fpf = elf.fpf


pf("generate elf-tkn-x.h (this won't overwrite the existing file)? (y/n)")

let will = _getch()
if will != 'y' ? {
	leave ()
}

elf.mydir("code/tools")

pf("generating tokens file...")
let file = elf.fopen("elf-tkn-x.h","wb")
lastly elf.fclose(file)
let _time = elf.clocktime()
lastly pf(" => took ", elf.timediffs(_time))



TK_CLASS_NONE     = -3
TK_CLASS_KEYWORD  = -2
TK_CLASS_MACRO    = -1
TK_CLASS_RANGE    =  1
TK_CLASS_OR       =  2
TK_CLASS_AND      =  3
TK_CLASS_BXOR     =  4
TK_CLASS_BOR      =  5
TK_CLASS_BAND     =  6
TK_CLASS_EQL      =  7
TK_CLASS_REL      =  8
TK_CLASS_SHIFT    =  9
TK_CLASS_ADD      = 10
TK_CLASS_MUL      = 11


K = TK_CLASS_KEYWORD
N = TK_CLASS_NONE
M = TK_CLASS_MACRO
MUL = TK_CLASS_MUL
MUL = TK_CLASS_MUL
MUL = TK_CLASS_MUL
ADD = TK_CLASS_ADD
ADD = TK_CLASS_ADD
SHIFT = TK_CLASS_SHIFT
SHIFT = TK_CLASS_SHIFT
REL = TK_CLASS_REL
REL = TK_CLASS_REL
REL = TK_CLASS_REL
REL = TK_CLASS_REL
EQL = TK_CLASS_EQL
EQL = TK_CLASS_EQL
BAND = TK_CLASS_BAND
BXOR = TK_CLASS_BXOR
BOR = TK_CLASS_BOR
AND = TK_CLASS_AND
OR = TK_CLASS_OR
RANGE = TK_CLASS_RANGE


Macros = {
	"line_number", "line_char_number", "file_name",
	"register", "level"
}

Keywords = {
	"elf",
	"load", "using",
	"try", "catch", "finally",
	"new",
	"this",
	"fun",
	"let",
	"for", "over", "in",
	"do", "while",
	"break", "continue", "leave",
	"lastly"
	"if", "iff", "elif", "then", "else",
	"nil", "true", "false",
}


Tokens = {}
Id = 0
Tk = fun(x,r,s) ? {
	let myid = Id
	Id = Id + 1
	let h = 0
	if (r == K || r == M) ? h = s:gethash()
	Tokens:add ({"n"=x,"r"=r,"s"=s,"v"=myid,"h"=h})
}

Tk("NONE", N, "none")

FstKeyword = Id
for i in Keywords:tally() ? {
	Tk(Keywords:idx(i):touppercase(),K,Keywords:idx(i))
}
LstKeyword = Id-1

FstMacro = Id
for i in Macros:tally() ? {
	Tk("M_":append(Macros:idx(i):touppercase()),M,Macros:idx(i))
}
LstMacro = Id

// 1.:to_integer()
// 2:to_number()
// 2:floor()
// 2:ceil()
// 2:to_string()
// 2degrees:to_radians()

Tk("INTEGER", N, "literal-integer")
Tk("NUMBER", N, "literal-number")
Tk("STRING", N, "literal-string")
Tk("LETTER", N, "literal-letter")
Tk("WORD", N, "identifier")
Tk("QUESTION_MARK", N, "?")
Tk("EXCLAMATION_MARK", N, "!")
Tk("ASSIGN_QUESTION", N, "?=")
Tk("ASSIGN", N, "=")
Tk("COLON", N, ":")
Tk("SEMI_COLON", N, ";")
Tk("DOT", N, ".")
Tk("COMMA", N, ",")
Tk("SQUARE_LEFT", N, "[")
Tk("SQUARE_RIGHT", N, "]")
Tk("CURLY_LEFT", N, "{")
Tk("CURLY_RIGHT", N, "}")
Tk("PAREN_LEFT", N, "(")
Tk("PAREN_RIGHT", N, ")")
Tk("MUL", MUL, "*")
Tk("DIV", MUL, "/")
Tk("MOD", MUL, "%")
Tk("ADD", ADD, "+")
Tk("SUB", ADD, "-")
Tk("SHR", SHIFT, ">>")
Tk("SHL", SHIFT, "<<")
Tk("LT", REL, "<")
Tk("LTEQ", REL, "<=")
Tk("GT", REL, ">")
Tk("GTEQ", REL, ">=")
Tk("EQ", EQL, "==")
Tk("NEQ", EQL, "!=")
Tk("BIT_AND", BAND, "&")
Tk("BIT_OR", BOR, "|")
Tk("BIT_XOR", BXOR, "^")
Tk("DOT_DOT", RANGE, "..")


FstKeywordOperator = Id
Tk("LOG_AND", AND, "and", {is_keyword=true})
Tk("LOG_OR", OR, "or", {is_keyword=true})
LstKeywordOperator = Id-1


fpf(file,"/*\n")
fpf(file,"** See Copyright Notice In elf.h\n")
fpf(file,"** elf-tkn.h (Autogenerated)\n")
fpf(file,"** This file was autogenerated by token.elf in tools\n")
fpf(file,"*/\n\n\n")


// todo: add support for backticks, to cope with
// my ocdness
fpf(file,"#define FIRST_KEYWORD ", FstKeyword, "\n")
fpf(file,"#define  LAST_KEYWORD ", LstKeyword, "\n\n\n")

fpf(file,"#define FIRST_MACRO ", FstMacro, "\n")
fpf(file,"#define  LAST_MACRO ", LstMacro, "\n\n\n")

fpf(file,"typedef struct elToken {\n")
fpf(file,"\tunsigned char type;\n")
fpf(file,"\telf_lineid line;\n")
fpf(file,"\tunsigned int eol: 1;\n")
fpf(file,"\tunion {\n")
fpf(file,"\t\tchar *s;\n")
fpf(file,"\t\telInteger i;\n")
fpf(file,"\t\telNumber n;\n")
fpf(file,"\t};\n")
fpf(file,"} elToken;\n\n\n")


fpf(file,"typedef enum elTokenType {\n")
for i in 0..Tokens:length() ? {
	let tk = Tokens:idx(i)

	let x = fpf(file,"\tTK_",tk.n);
	for _ in x..24 ? fpf(file," ")
	fpf(file," = ",tk.v,",\n")
}
fpf(file,"} elTokenType;\n\n\n")

fpf(file,"typedef struct elTokenIntel {\n")
fpf(file,"\tchar *name;\n")
fpf(file,"\tchar prec;\n")
fpf(file,"\telf_hashint hash;\n")
fpf(file,"} elTokenIntel;\n\n\n")

fpf(file,"elf_globaldecl elTokenIntel elTokenIntelTable[] = {\n")

for i in 0..Tokens:length() ? {
	let tk = Tokens:idx(i)

	fpf(file,"\t{")
	let x = fpf(file,"\"",tk.s,"\", ")
	for _ in x..24 ? fpf(file," ")
	fpf(file,tk.r,", ",tk.h,"},\n")
	// fpf(file,"\t{\"",tk.s,"\", ",tk.r,", ",tk.h,"},\n")
	// fpf(file,"\t{\"",tk.s,"\", ",tk.r,", ",tk.h,"},\n")
}
fpf(file,"};\n\n\n")


