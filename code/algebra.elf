operators = {
	"*" = { token = "*", inverse = "/", verb = "multiply", apply = fun(x, y) ? (x * y) },
	"/" = { token = "/", inverse = "*", verb = "divide", apply = fun(x, y) ? (x / y) },
	"-" = { token = "-", inverse = "+", verb = "subtract", apply = fun(x, y) ? (x - y) },
	"+" = { token = "+", inverse = "-", verb = "add", apply = fun(x, y) ? (x + y) },
	"=" = { token = "=", inverse = "!=", verb = "equals", apply = fun(x, y) ? (x == y) },
	">=" = { token = ">=", inverse = "<=", verb = "greater than or equal to", apply = fun(x, y) ? (x >= y) },
}

unary = fun(o, x) ? {
	if o != "number" && o != "variable" ? {
		elf.pf("'", o, "': invalid unary expression")
	}
	if o == "number" && elf.tagof(x) != "int" && elf.tagof(x) != "num" ? {
		elf.pf("'", o, "': invalid unary expression, operand is: ", elf.tagof(x))
	}
	if o == "variable" && elf.tagof(x) != "str" ? {
		elf.pf("'", o, "': invalid unary expression")
	}
	--> { type = o, x = x }
}

binary = fun(o, x, y) ? {
	--> { type = o, x = x, y = y }
}

_x_mul_2 := binary("*", unary("variable", "x"), unary("number", 2))
_x_add_6 := binary("+", unary("variable", "x"), unary("number", 6))
expr := binary(">=", _x_add_6, unary("number", 5))

print_expr = fun(expr) ? {
	if elf.tagof(expr) != "tab" ? {
		--> expr
	}
	if expr.type == "number" ? {
		--> expr.x
	} else if expr.type == "variable" ? {
		--> expr.x
	} else {
		--> "" + print_expr(expr.x) + " " + expr.type + " " + print_expr(expr.y)
	}
}
elf.pf("the equation is: ", print_expr(expr))

isolate = fun(expr) ? {
	if expr.isolated ? {
		--> nil
	}
	if expr.type == "number" || expr.type == "variable" ? {
		elf.pf("HERE!")
		--> nil
	}
	x := expr.x
	y := expr.y
	operator := operators[expr.type]
	if operator ? {
		inverse_operator := operators[operator.inverse]

		if x.type == "number" && y.type == "variable" ? {
			elf.pf("too difficult")
		} else if x.type == "variable" && y.type == "number" ? {
			elf.pf(inverse_operator.verb, " '", y.x, "' from both sides to isolate '", x.x, "'")
			--> binary(inverse_operator.token, nil, unary("number", y.x))
		} else {
			elf.pf("cannot isolate: ", expr.type)
		}
	} else {
		elf.error("error!")
	}
	--> nil
}
apply = fun(expr, oper) ? {
	if oper != nil ? {
		o := oper:clone()
		o.isolated = true
		o.x = expr
		--> o
	}
	--> expr
}

simplify = fun(expr) ? {
	x := expr.x
	y := expr.y
	operator := operators[expr.type]
	if operator ? {
		x = simplify(expr.x)
		y = simplify(expr.y)

		if x.type == "number" && y.type == "number" ? {
			elf.pf(" > do constant elimination: ", x.x, " ", operator.token, " ", y.x)
			output := operator.apply(x.x, y.x)
			--> unary("number", output)
		}
		--> binary(expr.type, x, y)
	} else {
		elf.pf("cannot reduce: ", expr.type)
	}
	--> expr
}


	// 6 - x >= 5
	// x - 6 >= 5
solution := "false"
if expr.type == ">=" ? {
	if expr.x.type == "number" ? {
		if expr.y.type == "number" ? {
			if expr.x.x >= expr.y.x ? {
				solution = "true"
			}
		}
	} else {
		elf.pf(" -> ", print_expr(expr))
		o := isolate(expr.x)
		expr.x = apply(expr.x, o)
		expr.y = apply(expr.y, o)
		elf.pf(" -> ", print_expr(expr))
		expr = simplify(expr)
		elf.pf(" -> ", print_expr(expr))
	}
}
elf.pf("Solution: ", solution)