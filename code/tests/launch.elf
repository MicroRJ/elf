/* test runner */
PREVDIR = elf.get_work_dir() lastly elf.change_work_dir(PREVDIR)
elf.change_work_dir("code/tests")

let sysfile = elf.fopen("tests.ignore","wb")
elf.fpf(sysfile,"test scores:\n")
lastly elf.fpf(sysfile,"end of test run");

numfails = 0

elf.enumdir(".",fun(file) ? {
	iff file.name:match("*.test.lang|*.test.elf") ? {
		leave false
	}
	let time_ = elf.clocktime()
	lastly elf.pf(" => took: ", elf.timediffs(time_))
	elf.pf("[TEST]: ", file.name)
	failed = false
	/* -- todo: ensure the test does declare
	more globals, store the global count
	beforehand, and then compare with after
	loading the file */
	load file.path
	__logging(false)
	if failed == true ? {
		numfails += 1
		elf.pf("[FAILED]")
	}
	leave true
})


if numfails == 1 ? {
	elf.pf(numfails, " test failed")
} elif numfails > 1 ? {
	elf.pf(numfails, " tests failed")
} else {
	elf.pf("all tests succeeded")
}


