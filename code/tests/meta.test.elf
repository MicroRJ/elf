Vector2 = {
	// __loop_get = fun(n) ? {
	// }
	// __loop_min = fun() ? {
	// }
	// __loop_max = fun() ? {
	// }
	__new = fun(x,y) ? {
		elf.pf("__new(",x,", ",y,")")
		this.x = x
		this.y = y
	}
	__add = fun(that) ? {
		leave vec2(this.x+that.x,this.y+that.y)
	}
}
vec2 = fun(x,y) ? {
	let v = new Vector2(x,y)
	leave v
}
elf.pf(vec2(2,2)+vec2(2,2))
vec2(2,2):__add(vec2(2,2))
