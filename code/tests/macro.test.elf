let a = 0
let b = 1
let c = 2
let _a = #register a
let _b = #register b
let _c = #register c
elf.pf(_a)
elf.pf(_b)
elf.pf(_c)

if #line_number != 1 ? failed = true
if #line_number != 2 ? failed = true
if #line_number != 3 ? failed = true
if #line_number != 4 ? failed = true
if #line_number != 5 ? failed = true
if #line_number != 6 ? failed = true
iff #file_name:match("*macro.test.elf") ? failed = true
elf.pf(">> file_name: ", #file_name)