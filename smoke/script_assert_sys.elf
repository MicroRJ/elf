path := "build/sys_smoke_test.txt"
missing := "build/sys_smoke_missing.txt"
fs := elf.fs
path_lib := elf.path

fs.remove(path)
fs.remove(missing)

test_assert(fs.read(missing) == nil)
test_assert(fs.exists(missing) == 0)

test_assert(fs.write(path, "hello fs") == 1)
test_assert(fs.read(path) == "hello fs")
test_assert(fs.exists(path) == 1)

info := fs.stat(path)
test_assert(info != nil)
test_assert(info.size == 8)

test_assert(path_lib.join("some/path", "name.ext") == "some/path/name.ext")
test_assert(path_lib.filename("some/path/name.ext") == "name.ext")
test_assert(path_lib.stem("some/path/name.ext") == "name")
test_assert(path_lib.extension("some/path/name.ext") == "ext")
test_assert(path_lib.parent("some/path/name.ext") == "some/path")

run := elf.process.run("cmd /d /c echo process-output")
test_assert(run.started == 1)
test_assert(run.success == 1)
test_assert(run.exit_code == 0)
test_assert(run.stdout != "")
test_assert(run.stderr == "")
test_assert(run.error == nil)

error_run := elf.process.run("cmd /d /c echo process-error 1>&2")
test_assert(error_run.started == 1)
test_assert(error_run.stderr != "")

failed_run := elf.process.run("cmd /d /c exit 7")
test_assert(failed_run.started == 1)
test_assert(failed_run.success == 0)
test_assert(failed_run.exit_code == 7)

missing_run := elf.process.run("elf_missing_process_7f31.exe")
test_assert(missing_run.started == 0)
test_assert(missing_run.success == 0)
test_assert(missing_run.error_code != 0)
test_assert(missing_run.error != nil)

test_assert(fs.remove(path) == 1)
test_assert(fs.read(path) == nil)

ret 77
