dy := elf.load_file("dy-core/project.elf")
dy.root = "dy-core"

internal_include_directories := [
	"src",
	"src/base",
	"src/core",
	"src/libs",
	"src/compiler",
	"src/compiler/frontend",
	"src/compiler/middle",
	"src/compiler/backend",
	"stb",
]

clone_table ::= fun(source) {
	result := {}
	for key := source:keys()[...] ? { result[key] = source[key] }
	ret result
}

library := {
	kind = "static_library",
	name = "elf",
	sources = [
		"src/bytecode.c",
		"src/core/elf_core.c",
		"src/libs/libs.c",
		"src/compiler/compiler.c",
		"src/linker.c",
		"src/compiler/entity.c",
		"src/compiler/frontend/parser.c",
		"src/compiler/middle/ir_emitter.c",
		"src/compiler/checker.c",
		"src/compiler/backend/bc_emitter.c",
	],
	private_include_directories = internal_include_directories,
	public_include_directories = [
		"include",
	],
	dependencies = [
		dy,
	],
}

public_header_test := {
	kind = "static_library",
	name = "public_header_test",
	sources = [ "test/public_header_compile_test.c" ],
	private_include_directories = [ "include" ],
}

core_tests := {
	kind = "executable",
	name = "core_tests",
	sources = [ "test/core_tests.c" ],
	private_include_directories = internal_include_directories,
	dependencies = [ library ],
}

run_core_tests := {
	kind = "run",
	name = "run core tests",
	target = core_tests,
}

tests := {
	kind = "executable",
	name = "tests",
	sources = [ "test/tests.c" ],
	private_include_directories = internal_include_directories,
	dependencies = [ library ],
}

run_tests := {
	kind = "run",
	name = "run elf tests",
	target = tests,
}

benchmarks := {
	kind = "executable",
	name = "benchmarks",
	sources = [ "tools/benchmarks.c" ],
	private_include_directories = internal_include_directories,
	dependencies = [ library ],
}

optimized_library := clone_table(library)
optimized_library.name = "elf_optimized"
optimized_library.compile_options = [ "/O2", "/DNDEBUG", "/U_DEBUG" ]

optimized_benchmarks := {
	kind = "executable",
	name = "benchmarks_opt",
	sources = [ "tools/benchmarks.c" ],
	private_include_directories = internal_include_directories,
	compile_options = [ "/O2", "/DNDEBUG", "/U_DEBUG" ],
	dependencies = [ optimized_library ],
}

run_optimized_benchmarks := {
	kind = "run",
	name = "run optimized benchmarks",
	target = optimized_benchmarks,
}

bytecode_tool := {
	kind = "executable",
	name = "bytecode",
	sources = [ "tools/bytecode.c" ],
	private_include_directories = internal_include_directories,
	dependencies = [ library ],
}

elf_runner := {
	kind = "executable",
	name = "elf",
	sources = [ "tools/elf.c" ],
	private_include_directories = internal_include_directories,
	dependencies = [ library ],
}

ret {
	name = "elf",
	root = ".",
	subprojects = {
		dy = dy,
	},
	default_target = library,
	targets = {
		library = library,
		public_header_test = public_header_test,
		core_tests = core_tests,
		run_core_tests = run_core_tests,
		tests = tests,
		run_tests = run_tests,
		benchmarks = benchmarks,
		optimized_library = optimized_library,
		optimized_benchmarks = optimized_benchmarks,
		run_optimized_benchmarks = run_optimized_benchmarks,
		bytecode_tool = bytecode_tool,
		elf_runner = elf_runner,
	},
}
