#if 0
static AstRef parse_expr_stat(Parser *parser)
{
	AstRef stat = 0;

	u32 ntargs = parse_decl_names(parser);

	Token tok = parser->tok;
	if ((tok.type == TOK_BIND) || (tok.type == TOK_HARD_BIND))
	{
		consume_token(parser);
		u32 tags = 0;
		if (tok.type == TOK_HARD_BIND) {
			tags |= ENTITY_TAG_CONSTANT;
		}

		AstRef *names = pop_ast_array(parser, ntargs);

		u32 nexprs = elf_parse_expr_list(parser);
		AstRef *exprs = pop_ast_array(parser, nexprs);

		stat = elf_new_decl_stat_tree(parser, tok.site, tags, names, ntargs, exprs, nexprs);
	}
	else
	{
		do
		{
			AstRef expr = parse_expr(parser, 0);
			if (notree(expr)) break;
			push_ast(parser, expr);
			++ ntargs;
		}
		while (pick_token(parser, TOK_COMMA));

		AstRef *targs = pop_ast_array(parser, ntargs);

		Token tok = parser->tok;
		if (pick_token(parser, TOK_ASSIGN))
		{
			u32 nexprs = elf_parse_expr_list(parser);
			AstRef *exprs = pop_ast_array(parser, nexprs);
			stat = elf_new_assign_stat_tree(parser, tok.site, targs, ntargs, exprs, nexprs);
		}
		else
		{
			stat = elf_new_comma_expr_tree(parser, tok.site, targs, ntargs);
		}
	}

	esc:
	return stat;
}
