#if 0
static AstRef build_range_loop(Parser *parser, AstRef expr, AstRef index, AstRef *values, AstRef body)
{

	ASSERT(expr);
	ASSERT(index);
	ASSERT(values);
	ASSERT(body);


	Token tok = parser->tok;


	// caller must have created a loop!
	Loop *loop = checkloop(parser, tok.line, Y_NULL);


	AstRef v;

	ASSERT(expr->kind == AST_RANGE || expr->kind == AST_RANGE_INDEX);

	AstRef rangelo = Y_NULL, rangehi = Y_NULL;
	AstRef prebody = Y_NULL;

	if (expr->kind == AST_RANGE_INDEX) {
		ASSERT(expr->x != Y_NULL);
		ASSERT(expr->y != Y_NULL);

		AstRef array = expr->x;
		AstRef range = expr->y;
		ASSERT(range->kind == AST_RANGE);

		rangelo = range->x;
		rangehi = range->y;

		begin_block(parser);
		{
			FOR_ARRAY(i, values) {
				// todo: special multi-index instruction?
				v = tree_index(parser, tok.line, array, index, i);
				v = tree_store(parser, tok.line, values[i], v);
				PushBlockStat(parser, v);
			}
		}
		prebody = close_block(parser);

		rangelo = range->x, rangehi = range->y;

		if (rangelo == Y_NULL) rangelo = tree_int(parser, range->site, 0);
		if (rangehi == Y_NULL) rangehi = tree_length(parser, range->site, array);
	}
	// RANGE
	else {
		// value same as index
		index = values[0];

		begin_block(parser);
		{
			for(int i=1; i<heap_array_length(values); ++ i) {
				v = tree_add_int(parser, tok.line, index, i);
				v = tree_store(parser, tok.line, values[i], v);
				PushBlockStat(parser, v);
			}
		}
		prebody = close_block(parser);

		rangelo = expr->x, rangehi = expr->y;

		if(rangelo == Y_NULL) rangelo = tree_int(parser,tok.line,0);
		// todo: if we don't have an upper bound replace condition entirely
		if(rangehi == Y_NULL) rangehi = tree_int(parser,tok.line,UINT_MAX);
	}


	ASSERT(rangelo != Y_NULL);
	ASSERT(rangehi != Y_NULL);


	// initialize index
	v = tree_store(parser,tok.line,index,rangelo);
	PushBlockStat(parser, v);

	// generate predicate
	AstRef pred = tree_less_than(parser, tok.line, index, rangehi);

	// what to do after the loop body's
	AstRef probody = tree_add_int_store(parser, tok.line, index, heap_array_length(values));



	// todo: instead of generating all this crap, just have
	// label instructions! that we can reference!
	v = create_ast(parser, tok.line, TREE_WHILE_LOOP);
	v->loop.pred    = pred;
	v->loop.body    = body;
	v->loop.prebody = prebody;
	v->loop.probody = probody;
	v->loop.c       = loop->continues;
	v->loop.b       = loop->breaks;
	return v;
}

// todo: check for references to loop decls, which are likely errors!
static AstRef *parse_for_steps(Parser *par, int elem)
{
	AstRef *s = 0;

	do
	{
		Token tok = par->tok;

		AstRef v;
		if (pick_token(par, TOK_PAREN_LEFT))
		{
			v = elf_parse_tuple_expr(par);
			take_tok_pair(par, TOK_PAREN_RIGHT, tok);
		}
		else
		{
			v = elf_parse_tuple_expr(par);
		}
		if (notree(v)) goto esc;

		heap_array_add(s, v);

	} while (pick_token(par, TOK_SEMI_COLON));

	esc:
	return s;
}

static int parse_for(Parser *parser) {
	int noerror = true;

	begin_block(parser);


	Token tok = take_token(parser,TOK_FOR);

	// todo: can we unify with regular statements?
	// a function that just returns a list of stores,
	// and then we desugar them? and that way is just
	// the one function?
	Token *names = parse_decl_names(parser);


	int status = ENTITY_TAG_ASSIGNED;

	if (pick_token(parser, TOK_HARD_BIND)) {

		status |= ENTITY_TAG_CONSTANT;
	}

	else if (pick_token(parser, TOK_BIND)) {
	}

	// todo: for compatibility!
	else if (pick_token(parser, TOK_ASSIGN)) {

		push_warning(parser, ERROR_SYNTAX_DEPRECATION, tok.line, "consider using ':=' instead!");
	}


	AstRef *steps = parse_for_steps(parser, heap_array_length(names));

	take_token(parser, TOK_QMARK);

	AstRef *values = 0;

	for (int i=0; i<heap_array_length(names); ++i) {
		Token name = names[i];

		AstRef v = tree_memory(parser, name.line, tree_nop(parser, name.line));
		PushBlockStat(parser, v);

		heap_array_add(values, v);

		parser_bind(parser, name.line
		, ENTITY_TAG_REFERENCED|ENTITY_TAG_ASSIGNED|ENTITY_BIT_FORLOOP
		, name.text, v);
	}



	// todo: generate conditionally, per step?
	AstRef index_ = tree_memory(parser,tok.line,tree_nop(parser,tok.line));
	PushBlockStat(parser,index_);

	// begin a new loop
	Loop *loop = begin_loop(parser);
	loop->index  = index_;
	loop->values = values;

	// todo: ensure success!
	AstRef body = parse_stat(parser);


	AstRef v;
	// generate loops or stores for each step
	FOR_ARRAY(i, steps)
	{
		AstRef step = steps[i];

		// create a new block for each step
		begin_block(parser);

		// check if the step translates into a loop
		if (step->kind == AST_RANGE || step->kind == AST_RANGE_INDEX)
		{
			v = build_range_loop(parser, step, index_, values, body);
			PushBlockStat(parser, v);
		}
		// DESUGAR EXPRESSION
		else if (step->kind == AST_TUPLE_EXPR)
		{
			AstRef index = index_;

			// todo: we shouldn't even have to do this!
			v = tree_store(parser, tok.line, index, tree_int(parser, tok.line, 0));
			PushBlockStat(parser, v);

			ASSERT(v->n >= 2);

			AstRef k = step->x;
			for (u32 i = 0; i < heap_array_length(values); ++ i)
			{
				if (k)
				{
					v = k;
					k = k->next;
				}
				else
				{
					v = tree_nil(parser, tok.line);
					warning_excess_rvalue(parser, values[i]);
				}

				v = tree_store(parser, tok.line, values[i], v);
				PushBlockStat(parser, v);
			}

			PushBlockStat(parser, body);
		}
		// SINGLE EXPRESSION
		else
		{
			AstRef index = index_;
			AstRef value = values[0];

			// todo: we shouldn't even have to do this!
			v = tree_store(parser, tok.line, index, tree_int(parser, tok.line, 0));
			PushBlockStat(parser, v);

			v = tree_store(parser, tok.line, value, step);
			PushBlockStat(parser, v);
			PushBlockStat(parser, body);

			// todo: break and continue should move on to the next
			// step!
			if (loop->continues || loop->breaks) {

				FOR_ARRAY(i, loop->continues){
					parser_dialog(parser
					,  loop->continues[i]->site,"breaks and continues are only for ranges");
				}

				FOR_ARRAY(i, loop->breaks){
					parser_dialog(parser
					, loop->breaks[i]->site,"breaks and continues are only for ranges");
				}

				reporterror(parser->inter, 0, "invalid syntax");
			}
		}


		// end block for this step and add to parent block
		v = close_block(parser);
		PushBlockStat(parser,v);
	}


	close_loop(parser);

	v = close_block(parser);
	PushBlockStat(parser, v);

	esc:
	return noerror;
}
#endif



#if 0
static void checkstoreto(Parser *par, Source line, AstRef tree){

	if (tree <= 0) {
		parser_dialog(par, line, "invalid l-value for store");
	}

	EntityId e = identify_tree(par, tree);

	if (e != NO_ENTITY) {
		if (par->entities[e].tags & ENTITY_TAG_CONSTANT) {
			parser_dialog(par, line
			,	"reassignment of constant entity");
			parser_dialog(par, par->entities[e].line
			,	"see declaration");
		}
	}
}
