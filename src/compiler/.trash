	u32 num = 0;
	while (peek_tok(par, TOK_IDENTIFIER) && peek_prox_tok(par, TOK_COMMA))
	{
		Ast *name = parse_ident_expr(par);
		push_ast(par, name);
		++ num;

		take_token(par, TOK_COMMA);
