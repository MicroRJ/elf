
static u32 elf_parse_expr_list(Parser *par)
{
	u32 nargs = 0;
	do
	{
		AstRef v = parse_expr(par, 0);
		if (notree(v)) goto esc;
		++ nargs;
		push_ast(par, v);
	}
	while (pick_token(par, TOK_COMMA));

	esc:
	return nargs;
}

// Todo, can we just remove this ?
static AstRef elf_parse_tuple_expr(Parser *par)
{
	Token tok = par->tok;
	u32 nargs = elf_parse_expr_list(par);
	AstRef expr;
	if (nargs > 1) {
		AstRef *args = pop_ast_array(par, nargs);
		expr = create_tuple_expr_ast(par, tok.site, args, nargs);
	} else {
		expr = PopTree(par);
	}
	return expr;
}


