#if 0
// todo: this double evaluates the operands
// of the condition expression!
static void parse_assert(Parser *parser)
{
	Token tok = take_token(parser, TOK_M_ASSERT);

	AstRef cond = parse_expr(parser, 0);

	TreeChain args = {};
	tree_chain_add(&args, cond);

	Stringer sb = {};

	// todo: also, what's the point of doing any of this...
	switch (cond->kind)
	{
		case AST_NOT_EQ:   sb_writetext(&sb, "(% != %) is false"); goto _bcase;
		case AST_EQ:    sb_writetext(&sb, "(% == %) is false"); goto _bcase;
		case AST_OR:    sb_writetext(&sb, "(% || %) is false"); goto _bcase;
		case AST_LESS_THAN:    sb_writetext(&sb, "(% < %) is false"); goto _bcase;
		case AST_GREATER_THAN_EQ:    sb_writetext(&sb, "(% > %) is false"); goto _bcase;
		case AST_GREATER_THAN_EQ:  sb_writetext(&sb, "(% >= %) is false"); goto _bcase;
		case AST_LESS_THAN_EQ:  sb_writetext(&sb, "(% <= %) is false"); goto _bcase;

		default: {

			parser_dialog(parser, tok.line, "expression not supported for #assert");
			goto esc;

			_bcase:
			// todo: leak! sb cannot be freed because trees still use
			// char *
			AstRef tformatstr = create_str_ast(parser, tok.line, sb.buf);

			AstRef tcallformat = tree_callcoreapi3(parser, tok.line
			, BUILTIN_FORMAT, tformatstr, cond->x, cond->y);

			tree_chain_add(&args, tcallformat);
		} break;
	}

	AstRef v = tree_callcoreapi(parser, tok.line, BUILTIN_ASSERT, args);
	PushBlockStat(parser, v);
	esc:
	return;
}

// Todo, can we return a new tree instead of mutating the existing one?
static void rewrite_lhs(Parser *par, AstRef lhs)
{
	if (lhs->kind == AST_FIELD || lhs->kind == AST_INDEX)
	{
		// already memory
		if (lhs->x->kind != TREE_MEMORY)
		{
			AstRef v = tree_memory(par, lhs->x->site, lhs->x);
			PushBlockStat(par, v);

			lhs->x = v;
		}
	}
}

static TreeChain parse_rhs(Parser *parser, u32 num_lhs, AstType empty)
{
	TreeChain rhs = {};

	do
	{
		if (pick_token(parser, TOK_ELLIPSIS))
		{
			// helper message
			if (rhs.tally >= num_lhs)
			{
				parser_dialog(parser, parser->tok.site
				, "redundant ellipsis, enough r-values already!");
			}

			// '...' with no previous y's just means fill everything with nil,
			// which is what happens by default
			if (rhs.tally)
			{
				AstRef r = rhs.tail;
				for (u32 i=rhs.tally; i<num_lhs; ++i)
				{
					tree_chain_add(&rhs, r);
				}
			}


			// helper message
			if (peek_tok(parser, TOK_COMMA))
			{
				parser_dialog(parser, parser->tok.site
				, "'...': terminates the expression list");
			}
			break;
		}

		AstRef v = parse_expr(parser, 0);
		if (notree(v)) break;

		tree_chain_add(&rhs, v);

		if (rhs.tally > num_lhs)
		{
			parser_dialog(parser, parser->tok.site
			, "warning: excess right hand side value");
		}
	}
	while (pick_token(parser, TOK_COMMA));

	// fill with nil
	for (u32 i=rhs.tally; i<num_lhs; ++i)
	{
		tree_chain_add(&rhs, tree_nullary(parser, parser->tok.site, empty));
	}
	return rhs;
}

static AstRef *complete_lhs(Parser *parser, Token *names) {
	AstRef *l = 0;

	// convert all names to storage targets
	for (int i=0; i<heap_array_length(names); ++i) {
		char *name = names[i].text;
		AstRef v=nametolval(parser, names[i].line, name);
		if (v==Y_ERROR) goto _err;
		heap_array_add(l, v);
	}

	// parse additional expressions
	do {
		AstRef v = parse_expr(parser, 0);
		if (notree(v)) goto _err;

		heap_array_add(l, v);
	} while (pick_token(parser, TOK_COMMA));


	_err:
	return l;
}

#endif

#if 0
static int parse_expr_stat(Parser *parser) {

	int success = false;

	Token tok = parser->tok;

	// Todo, remove dynamic array use!
	Token *names = parse_decl_names(parser);

	// this is a declaration
	if (peek_tok(parser, TOK_BIND) || peek_tok(parser, TOK_HARD_BIND))
	{
		if (heap_array_length(names) <= 0)
		{
			push_error(parser, ERROR_INVALID_DECL, tok.line
			, "invalid declaration, left hand side is not a name");
		}

		EntityTags status = ENTITY_TAG_ASSIGNED;

		if (pick_token(parser, TOK_HARD_BIND))
		{
			status |= ENTITY_TAG_CONSTANT;
		}
		else
		{
			take_token(parser, TOK_BIND);
		}

		TreeChain rhs = parse_rhs(parser, heap_array_length(names), TREE_NOP);
		ASSERT(rhs.tally >= heap_array_length(names));

		//
		// Todo:
		// Reason for memory tree taking an initializer is to
		// evaluate the initializer without first allocating
		// memory for the memory tree, which is what happens
		// if you do memory tree and then a store.
		// Getting rid of the initializer however, would make
		// this neater because the path for decls and stores
		// would merge.
		// ---
		// Could we make the generator, simply not allocate the memory
		// until it is first used or stored to?
		//
		// note that we only bind the lhs once we've parsed
		// the rhs!
		//
		AstRef next_rhs = rhs.head;
		for (int i = 0; i < heap_array_length(names); ++ i)
		{
			char *name = names[i].text;

			int rem = heap_array_length(names) - i;

			AstRef v = tree_memory2(parser, names[i].line, next_rhs, rem);
			PushBlockStat(parser, v);

			parser_bind(parser, names[i].line, status, name, v);
			next_rhs = next_rhs->next;
		}

		success = true;
	}
	// not a decl
	else {

		AstRef *lhs = complete_lhs(parser, names);
		TreeChain rhs = {};

		tok = parser->tok;

		if (heap_array_length(lhs) <= 0) {
			goto _err;
		}

		if (pick_token(parser,TOK_ASSIGN)){
		}
		else if (pick_token(parser,TOK_NIL_ASSIGN)){
		}
		else if (token_rank_from_type(tok.type) > 0){
			consume_token(parser);
			take_token(parser, TOK_ASSIGN);
		}
		else {
			goto _regularexpr;
		}

		for (int i = 0; i < heap_array_length(lhs); ++ i) {
			checkstoreto(parser, tok.line, lhs[i]);
		}


		rhs = parse_rhs(parser, heap_array_length(lhs), AST_NIL_LITERAL);
		ASSERT(rhs.tally >= heap_array_length(lhs));


		// regular store
		if (tok.type == TOK_ASSIGN)
		{
			AstRef next_rhs = rhs.head;
			for (int i=0; i<heap_array_length(lhs); ++i)
			{
				MEMORY_SCOPE(parser)
				{
					AstRef v = tree_store(parser, tok.line, lhs[i], next_rhs);
					PushBlockStat(parser, v);
				}

				next_rhs = next_rhs->next;
			}
		}
		else if (tok.type == TOK_NIL_ASSIGN)
		{
			AstRef next_rhs = rhs.head;
			for (int i=0; i<heap_array_length(lhs); ++i)
			{
				MEMORY_SCOPE(parser)
				{
					rewrite_lhs(parser, lhs[i]);

					AstRef c = elf_new_binary_expr_tree(parser, tok.line, AST_EQ, lhs[i], tree_nil(parser, tok.line));
					AstRef s = tree_store(parser, tok.line, lhs[i], next_rhs);
					AstRef v = elf_new_if_stat_tree(parser, tok.line, c, s, 0);
					PushBlockStat(parser, v);
				}
				next_rhs = next_rhs->next;
			}
		}
		else if (token_rank_from_type(tok.type) > 0)
		{
			//
			// if we got here it means that we attempted to
			// parse an expression that looked like a binary
			// operator, e.g '+''=', but it turned out to be
			// an assignment, so the parser returned the left
			// hand side expression but didn't take the token.
			//
			AstRef next_rhs = rhs.head;
			for (int i = 0; i < heap_array_length(lhs); ++ i)
			{
				MEMORY_SCOPE(parser)
				{
					rewrite_lhs(parser, lhs[i]);

					AstRef o = elf_new_binary_expr_tree(parser, tok.line, tree_kind_from_token_type(tok.type), lhs[i], next_rhs);
					AstRef v = tree_store(parser, tok.line, lhs[i], o);
					PushBlockStat(parser, v);
				}
				next_rhs = next_rhs->next;
			}
		}
		else
		{
			_regularexpr:
			// if they're regular expressions, just add them to the
			// block and the generator will figure out whether
			// to keep them or not
			FOR_ARRAY(i, lhs)
			{
				// top-level memory trees mean "allocate" memory, there's
				// no way to "reference" memory, either way, prune it.
				if (lhs[i]->kind != TREE_MEMORY)
				{
					PushBlockStat(parser, lhs[i]);
				}
			}
		}

		success = true;
		free_heap_array(lhs);

		// not a decl branch
	}

	free_heap_array(names);

	_err:
	return success;
}
#endif



