#if 0
static void tree_chain_prepend(TreeChain *v, Ast *r)
{
	ASSERT(!r->next);

	if (!v->head)
	{
		v->head = v->tail = r;
	}
	else
	{
		r->next = v->head;
		v->head = r;
	}

	++ v->tally;
}

static void tree_chain_add(TreeChain *v, Ast *r)
{
	ASSERT(!r->next);

	if (!v->head)
	{
		v->head = v->tail = r;
	}
	else
	{
		v->tail = v->tail->next = r;
	}

	++ v->tally;
}

static AstRef tree_get_next(AstRef tr)
{
	return tr->next;
}
