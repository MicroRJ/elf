compiler := "clang-cl"
librarian := "lib"
compile_options := " /nologo /Od /Zi /D_DEBUG /DPLATFORM_DESKTOP -fcolor-diagnostics -fansi-escape-codes"

build_options := {
	workers = 4,
	verbosity = 0,
}

include_dirs := {
	"src",
	"src/base",
	"src/api",
	"src/core",
	"src/diagnostics",
	"src/core/libs",
	"src/core/value",
	"src/core/table",
	"src/core/atom",
	"src/compiler",
	"src/compiler/frontend",
	"src/compiler/middle",
	"src/compiler/backend",
	"batteries",
	"src/batteries/internal",
	"include",
	"platform/include",
	"stb",
}

batteries_include_dirs := {
	"include",
	"src/batteries/internal",
	"platform/include",
}

join_arguments := fun(values) {
	result := ""
	for value := values[...] ? { result += f" ${value}" }
	ret result
}

make_include_options := fun(directories) {
	result := ""
	for directory := directories[...] ? { result += f" /I${directory}" }
	ret result
}

include_options := make_include_options(include_dirs)
batteries_include_options := make_include_options(batteries_include_dirs)

prepare := {
	name = "prepare build directory",
	command_line = "cmd /c if not exist build\\obj mkdir build\\obj",
	inputs = {},
	outputs = { "build/obj" },
	include_dirs = {},
	dependencies = {},
}

build_platform := {
	name = "build platform library",
	command_line = "cmd /c \"cd /d platform && ..\\bootstrap\\windows-x64\\bob.exe build.elf lib\"",
	inputs = {
		"platform/build.elf",
		"platform/include/platform.h",
		"platform/include/platform_types.h",
		"platform/src/platform_win32.c",
	},
	outputs = { "platform/build/platform.lib" },
	include_dirs = {},
	dependencies = {},
	transparent = true,
}

compile_source := fun(name, source, includes, dependency_includes) {
	object := f"build/obj/${name}.obj"
	task := {
		name = f"compile ${name}",
		command_line = f"${compiler}${compile_options}${includes} /c ${source} /Fo${object} /Fdbuild/obj/${name}.pdb",
		inputs = { source },
		outputs = { object },
		include_dirs = dependency_includes,
		dependencies = { prepare },
	}
	ret { task = task, object = object }
}

elf_sources := {
	{ name = "base",           path = "src/base/base.c" },
	{ name = "value",          path = "src/core/value/value.c" },
	{ name = "bytecode",       path = "src/compiler/backend/bytecode.c" },
	{ name = "bytecode_debug", path = "src/compiler/backend/bytecode_debug.c" },
	{ name = "core",           path = "src/core/core.c" },
	{ name = "compiler",       path = "src/compiler/compiler.c" },
	{ name = "elf_api",        path = "src/api/elf_api.c" },
}

elf_objects := {}
elf_compile_tasks := {}
for source := elf_sources[...] ? {
	compiled := compile_source(source.name, source.path, include_options, include_dirs)
	elf_objects:add(compiled.object)
	elf_compile_tasks:add(compiled.task)
}

elf_library := {
	name = "archive elf.lib",
	command_line = f"${librarian} /nologo /out:build/elf.lib${join_arguments(elf_objects)}",
	inputs = elf_objects,
	outputs = { "build/elf.lib" },
	include_dirs = {},
	dependencies = elf_compile_tasks,
}

batteries := compile_source("batteries", "src/batteries/batteries.c", batteries_include_options, batteries_include_dirs)

batteries_library := {
	name = "archive elf_batteries.lib",
	command_line = f"${librarian} /nologo /out:build/elf_batteries.lib ${batteries.object}",
	inputs = { batteries.object },
	outputs = { "build/elf_batteries.lib" },
	include_dirs = {},
	dependencies = { batteries.task },
}

build_tool := fun(name, source, output, uses_batteries) {
	object := f"build/obj/tool_${output}.obj"
	executable := f"build/${output}.exe"
	inputs := { source, "build/elf.lib", "platform/build/platform.lib" }
	dependencies := { elf_library, build_platform }
	libraries := " build/elf.lib platform/build/platform.lib"
	if uses_batteries ? {
		inputs:add("build/elf_batteries.lib")
		dependencies:add(batteries_library)
		libraries += " build/elf_batteries.lib"
	}
	task := {
		name = f"build ${name}",
		command_line = f"${compiler}${compile_options}${include_options} ${source} /Fo${object} /Fe:${executable} /Fd:build/obj/tool_${output}.pdb /link${libraries} /PDB:build/${output}.pdb /ILK:build/${output}.ilk",
		inputs = inputs,
		outputs = { executable },
		include_dirs = include_dirs,
		dependencies = dependencies,
	}
	ret { task = task, executable = executable }
}

core_tests := build_tool("core tests", "tools/core_tests.c", "core_tests", false)
tests := build_tool("tests", "tools/tests.c", "tests", true)
benchmarks := build_tool("benchmarks", "tools/benchmarks.c", "benchmarks", false)
bytecode_tool := build_tool("bytecode tool", "tools/bytecode.c", "bytecode", true)
elf_runner := build_tool("elf runner", "tools/elf.c", "elf", true)

run_core_tests := {
	name = "run core tests",
	command_line = core_tests.executable,
	inputs = { core_tests.executable },
	outputs = {},
	include_dirs = {},
	dependencies = { core_tests.task },
}

run_tests := {
	name = "run elf tests",
	command_line = tests.executable,
	inputs = { tests.executable },
	outputs = {},
	include_dirs = {},
	dependencies = { tests.task },
}

entries := {}

entries.lib = fun() {
	ret bob.build({
		targets = { elf_library, batteries_library, build_platform },
		options = build_options,
	})
}

entries.build = fun() {
	ret bob.build({
		targets = { core_tests.task, tests.task, benchmarks.task, bytecode_tool.task, elf_runner.task },
		options = build_options,
	})
}

entries.test = fun() {
	ret bob.build({
		targets = { run_core_tests, run_tests },
		options = build_options,
	})
}

ret entries
