//
// Elf builds itself with Bob. Bob embeds a released Elf runtime, so this file
// should remain compatible with the Elf version reported by `bob --version`.
//


// Data -----------------------------------------------------------------------

project := {
	compiler = "clang-cl",
	librarian = "lib",
	compile_options = " /nologo /Od /Zi /D_DEBUG /DPLATFORM_DESKTOP -fcolor-diagnostics -fansi-escape-codes",

	prepare = {
		name = "prepare build directory",
		directory = "build\\obj",
		output = "build/obj",
	},

	library = {
		name = "archive elf.lib",
		output = "build/elf.lib",
	},

	build_options = {
		workers = 4,
		verbosity = 0,
	},
}

include_dirs := {
	"src",
	"src/base",
	"src/api",
	"src/core",
	"src/diagnostics",
	"src/core/value",
	"src/core/table",
	"src/core/atom",
	"src/platform",
	"src/runtime",
	"src/runtime/vm",
	"src/runtime/libs",
	"src/compiler",
	"src/compiler/frontend",
	"src/compiler/middle",
	"src/compiler/backend",
	"include",
	"stb",
}

source_specs := {
	{ name = "base",           path = "src/base/base.c" },
	{ name = "platform",       path = "src/platform/win32/platform_win32.c" },
	{ name = "value",          path = "src/core/value/value.c" },
	{ name = "bytecode",       path = "src/compiler/backend/bytecode.c" },
	{ name = "bytecode_debug", path = "src/compiler/backend/bytecode_debug.c" },
	{ name = "core",           path = "src/core/core.c" },
	{ name = "compiler",       path = "src/compiler/compiler.c" },
	{ name = "elf_api",        path = "src/api/elf_api.c" },
	{ name = "elf_stack_api",  path = "src/api/elf_stack_api.c" },
}

tool_specs := {
	{ name = "tests",         source = "tools/tests.c",      output = "tests" },
	{ name = "benchmarks",    source = "tools/benchmarks.c", output = "benchmarks" },
	{ name = "bytecode tool", source = "tools/bytecode.c",   output = "bytecode" },
	{ name = "elf runner",    source = "tools/elf.c",        output = "elf" },
}

run_specs := {
	{ name = "run Elf tests", tool = "tests" },
}


// Processing -----------------------------------------------------------------

join_arguments := fun(values) {
	result := ""
	for value := values[...] ? { result += f" ${value}" }
	ret result
}

make_include_options := fun(directories) {
	result := ""
	for directory := directories[...] ? { result += f" /I${directory}" }
	ret result
}

create_prepare_task := fun(spec) {
	ret {
		name = spec.name,
		command_line = f"cmd /c if not exist ${spec.directory} mkdir ${spec.directory}",
		inputs = {},
		outputs = { spec.output },
		include_dirs = {},
		dependencies = {},
	}
}

compile_source := fun(spec, prepare_task, include_options) {
	object := f"build/obj/${spec.name}.obj"
	pdb := f"build/obj/${spec.name}.pdb"
	task := {
		name = f"compile ${spec.name}",
		command_line = f"${project.compiler}${project.compile_options}${include_options} /c ${spec.path} /Fo${object} /Fd${pdb}",
		inputs = { spec.path },
		outputs = { object },
		include_dirs = include_dirs,
		dependencies = { prepare_task },
	}
	ret { task = task, object = object }
}

process_sources := fun(specs, prepare_task, include_options) {
	result := {
		tasks = {},
		objects = {},
	}

	for spec := specs[...] ? {
		compiled := compile_source(spec, prepare_task, include_options)
		result.tasks:add(compiled.task)
		result.objects:add(compiled.object)
	}

	ret result
}

create_library_task := fun(spec, compiled_sources) {
	ret {
		name = spec.name,
		command_line = f"${project.librarian} /nologo /out:${spec.output}${join_arguments(compiled_sources.objects)}",
		inputs = compiled_sources.objects,
		outputs = { spec.output },
		include_dirs = {},
		dependencies = compiled_sources.tasks,
	}
}

compile_tool := fun(spec, library_task, include_options) {
	object := f"build/obj/tool_${spec.output}.obj"
	executable := f"build/${spec.output}.exe"
	compile_pdb := f"build/obj/tool_${spec.output}.pdb"
	link_pdb := f"build/${spec.output}.pdb"
	ilk := f"build/${spec.output}.ilk"
	task := {
		name = f"build ${spec.name}",
		command_line = f"${project.compiler}${project.compile_options}${include_options} ${spec.source} /Fo${object} /Fe:${executable} /Fd:${compile_pdb} /link ${project.library.output} /PDB:${link_pdb} /ILK:${ilk}",
		inputs = { spec.source, project.library.output },
		outputs = { executable },
		include_dirs = include_dirs,
		dependencies = { library_task },
	}
	ret {
		output = spec.output,
		executable = executable,
		task = task,
	}
}

process_tools := fun(specs, library_task, include_options) {
	result := {
		tasks = {},
		tools = {},
	}

	for spec := specs[...] ? {
		compiled := compile_tool(spec, library_task, include_options)
		result.tasks:add(compiled.task)
		result.tools:add(compiled)
	}

	ret result
}

find_tool := fun(compiled_tools, output) {
	for tool := compiled_tools.tools[...] ? {
		if tool.output == output ? { ret tool }
	}
	ret nil
}

process_runs := fun(specs, compiled_tools) {
	tasks := {}
	for spec := specs[...] ? {
		tool := find_tool(compiled_tools, spec.tool)
		elf.assert(tool != nil, f"unknown tool '${spec.tool}' in run specification")
		tasks:add({
			name = spec.name,
			command_line = tool.executable,
			inputs = { tool.executable },
			outputs = {},
			include_dirs = {},
			dependencies = { tool.task },
		})
	}
	ret tasks
}


// Tasks ----------------------------------------------------------------------

include_options := make_include_options(include_dirs)
prepare_task := create_prepare_task(project.prepare)
compiled_sources := process_sources(source_specs, prepare_task, include_options)
library_task := create_library_task(project.library, compiled_sources)
compiled_tools := process_tools(tool_specs, library_task, include_options)
run_tasks := process_runs(run_specs, compiled_tools)


// Entries --------------------------------------------------------------------

entries := {}

entries.lib = fun() {
	ret bob.build({
		targets = { library_task },
		options = project.build_options,
	})
}

entries.build = fun() {
	ret bob.build({
		targets = compiled_tools.tasks,
		options = project.build_options,
	})
}

entries.test = fun() {
	ret bob.build({
		targets = run_tasks,
		options = project.build_options,
	})
}

ret entries
