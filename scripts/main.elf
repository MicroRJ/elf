
AGENT_STATE_IDLE     :: "IDLE"
AGENT_STATE_THINKING :: "THINKING"
AGENT_STATE_APPROVAL :: "APPROVAL"
AGENT_STATE_WORKING  :: "WORKING"
AGENT_STATE_BROKEN   :: "BROKEN"
AGENT_STATE_RETRYING :: "RETRYING"

MAX_RETRY_COUNT       :: 3
RATE_LIMIT_RETRY_MS   :: 60000
UNAVAILABLE_RETRY_MS  :: 5000

chats := [{
	active_state = AGENT_STATE_IDLE,
	time_start   = elf.time.unix_ms(),
	agent_state  = {
		tool_results  = [],
		tool_requests = [],
		retry_count   = 0,
	},

	messages = [
		{
			type = MESSAGE_TYPE_USER,
			text = "This is a dummy message!"
		},
		{
			type = MESSAGE_TYPE_AGENT,
			items = [
				{
					type = "markdown",
					text = "This is a dummy message!",
					blocks = Markdown.parse("this is a ```dummy``` markdown file, and this is italic *** like so *** "),
				}
			]
		}
	]
}]

#eof

// what about multiple returns?

foo :: fun() {
	defer elf.printl("foo")
	ret 7, 4, 5, 4, 1, 2, 3, 4
}

a, b, c, d := foo()
elf.println(a, ", ", b, ", ", c, ", ", d)
#eof

totally_unrelated_function :: fun() {
	elf.println(f"yep, I can also see '${this.name}'")
}

new_person := fun(name: str) {
	person := {

		say_hi = fun() {
			name ::= this.name
			elf.printl(f"you said hi to '${name}'")

			// we now about this, but will this also carry onto other functions?
			totally_unrelated_function()
		}
	}
	person.name = name
	ret person
}

person := new_person("dy")
person.say_hi()

#eof

new_person := fun(name: str) {
	person := {
		say_hi = fun() {
			elf.printl(f"you said hi to ${this.name}")
		}
	}
	person.name = name
	ret person
}

person := new_person("dy")
person.say_hi()

#eof
pipeline :: import "scripts/trace_pipeline.elf"

handle_message :: fun(message) {
	stream := {
		channels = [
			[10, 20, 30],
			[40, 50, 60],
		],
	}
	packet := {
		channel = message.route,
		start = message.sequence - 100,
		stride = message.retry + 1,
	}
	ret pipeline.decode(stream, packet)
}

handle_message({ route = 1, sequence = 102, retry = 0 })
