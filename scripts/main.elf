fib := fun(n) {
	if n < 2 ? {
		ret n
	}

	ret recurse(n - 1) + recurse(n - 2)
}

elf.printl(fib(0), ": ", 0)
elf.printl(fib(1), ": ", 1)
elf.printl(fib(6), ": ", 8)

ret fib(10)


