wrapper :: fun() {

	wrapper :: fun() {
		x, y, z, w := elf.nargs() * 1, elf.nargs() * 2, elf.nargs() * 3, elf.nargs() * 4
		ret x, y, z, w
	}

	x, y, z, w := wrapper()
	ret x, y, z, w
}

x, y, z, w := wrapper()
ret x, y, z, w
