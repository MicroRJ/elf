#eof

totally_unrelated_function :: fun() {
	elf.println(f"yep, I can also see '${this.name}'")
}

new_person := fun(name: str) {
	person := {

		say_hi = fun() {
			name ::= this.name
			elf.printl(f"you said hi to '${name}'")

			// we now about this, but will this also carry onto other functions?
			totally_unrelated_function()
		}
	}
	person.name = name
	ret person
}

person := new_person("dy")
person.say_hi()

#eof

new_person := fun(name: str) {
	person := {
		say_hi = fun() {
			elf.printl(f"you said hi to ${this.name}")
		}
	}
	person.name = name
	ret person
}

person := new_person("dy")
person.say_hi()

#eof
pipeline :: import "scripts/trace_pipeline.elf"

handle_message :: fun(message) {
	stream := {
		channels = [
		[10, 20, 30],
		[40, 50, 60],
		],
	}
	packet := {
		channel = message.route,
		start = message.sequence - 100,
		stride = message.retry + 1,
	}
	ret pipeline.decode(stream, packet)
}

handle_message({ route = 1, sequence = 102, retry = 0 })
